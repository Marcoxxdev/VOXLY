<Window x:Class="VoiceClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:VoiceClient"
        Title="VOXLY" Icon="Assets/voxly.png" Width="1000" Height="680" MinWidth="880" MinHeight="580"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        FontFamily="Segoe UI" FontSize="14"
        PreviewKeyDown="Window_PreviewKeyDown" PreviewMouseDown="Window_PreviewMouseDown" Closing="Window_Closing">
  <Grid>
    <!-- ===== GŁÓWNY INTERFEJS ===== -->
    <Grid x:Name="MainUi">
      <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="84"/>
      </Grid.RowDefinitions>

      <Grid Grid.Row="0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="180"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- pasek boczny -->
        <Border Background="{StaticResource Panel}">
          <DockPanel>
            <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,12">
              <TextBlock Text="VOXLY" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" Foreground="{StaticResource Accent}"/>
              <TextBlock Text="by Marcoxxdev" FontSize="11" HorizontalAlignment="Center" Foreground="{StaticResource Muted}"/>
            </StackPanel>
            <StackPanel>
              <Image Source="Assets/voxly.png" Width="92" Height="92" HorizontalAlignment="Center" Margin="0,14,0,6"
                     RenderOptions.BitmapScalingMode="HighQuality"/>
              <TextBlock x:Name="TxtServer" Text="Serwer" FontWeight="SemiBold" FontSize="15" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="8,0"/>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,14">
                <Ellipse Width="8" Height="8" Fill="{StaticResource Green}" Margin="0,0,6,0"/>
                <TextBlock Text="{local:Tr connected}" FontSize="12" Foreground="{StaticResource Green}"/>
              </StackPanel>
              <Border Height="1" Background="{StaticResource Line}" Margin="14,0,14,10"/>
              <Button Tag="ch" Click="Nav_Click" Background="Transparent" HorizontalContentAlignment="Left" Margin="8,2">
                <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE80F;" FontSize="18" Width="32"/><TextBlock Text="{local:Tr nav_channels}"/></StackPanel>
              </Button>
              <Button Tag="chat" Click="Nav_Click" Background="Transparent" HorizontalContentAlignment="Left" Margin="8,2">
                <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8BD;" FontSize="18" Width="32"/><TextBlock Text="{local:Tr nav_chat}"/></StackPanel>
              </Button>
              <Button Tag="users" Click="Nav_Click" Background="Transparent" HorizontalContentAlignment="Left" Margin="8,2">
                <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE716;" FontSize="18" Width="32"/><TextBlock Text="{local:Tr nav_users}"/></StackPanel>
              </Button>
              <Button x:Name="BtnNavClients" Tag="clients" Click="Nav_Click" Background="Transparent" HorizontalContentAlignment="Left" Margin="8,2" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE77B;" FontSize="18" Width="32"/><TextBlock Text="{local:Tr cl_nav}"/></StackPanel>
              </Button>
              <Button Tag="set" Click="Nav_Click" Background="Transparent" HorizontalContentAlignment="Left" Margin="8,2">
                <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE713;" FontSize="18" Width="32"/><TextBlock Text="{local:Tr nav_settings}"/></StackPanel>
              </Button>
              <Button x:Name="BtnCheckUpdate" Click="CheckUpdate_Click" Background="Transparent" HorizontalContentAlignment="Left" Margin="8,2">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Left" FontFamily="Segoe MDL2 Assets" Text="&#xE895;" FontSize="18" Width="32" VerticalAlignment="Center"/>
                  <TextBlock Text="{local:Tr upd_check}" TextWrapping="Wrap" FontSize="13" VerticalAlignment="Center"/>
                </DockPanel>
              </Button>
              <TextBlock x:Name="TxtUpdateStatus" FontSize="11" TextWrapping="Wrap" TextAlignment="Center" Margin="14,0,14,6"/>
            </StackPanel>
          </DockPanel>
        </Border>

        <!-- strony -->
        <Grid Grid.Column="1">
          <!-- Kanały -->
          <Grid x:Name="PgChannels" Margin="18,14,8,10">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <DockPanel Margin="0,0,10,12">
              <Button x:Name="BtnAddChannel" DockPanel.Dock="Right" Content="{local:Tr add_channel}" Visibility="Collapsed" Click="AddChannel_Click"/>
              <StackPanel>
                <TextBlock Text="{local:Tr voice_channels}" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock x:Name="TxtChannelsHint" Text="" FontSize="12" Foreground="{StaticResource Muted}"/>
              </StackPanel>
            </DockPanel>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
              <ItemsControl x:Name="ChannelsList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Background="{StaticResource Card}" CornerRadius="8" Margin="0,0,10,8" Tag="{Binding}"
                            BorderBrush="Transparent" BorderThickness="2" AllowDrop="True"
                            DragEnter="Card_DragEnter" DragOver="Card_DragOver" DragLeave="Card_DragLeave" Drop="Card_Drop">
                      <StackPanel>
                        <Border Background="{StaticResource CardHead}" CornerRadius="6,6,0,0" Padding="14,10" Cursor="Hand" Tag="{Binding}"
                                PreviewMouseLeftButtonDown="Channel_Down" MouseMove="Channel_Move"
                                MouseLeftButtonUp="Channel_Click" MouseRightButtonUp="Channel_RightClick">
                          <StackPanel Orientation="Horizontal" Opacity="{Binding HeadOpacity}">
                            <Ellipse Width="11" Height="11" Fill="{Binding ColorBrush}" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Visibility="{Binding LockVis}" FontFamily="Segoe MDL2 Assets" Text="&#xE72E;" FontSize="13"
                                       Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            <Border Visibility="{Binding AccessVis}" Background="#33FFFFFF" CornerRadius="4" Padding="6,1" Margin="10,0,0,0" VerticalAlignment="Center">
                              <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72E;" FontSize="10" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBlock Text="{Binding AccessText}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Muted}"/>
                              </StackPanel>
                            </Border>
                          </StackPanel>
                        </Border>
                        <ItemsControl ItemsSource="{Binding Users}" Margin="8,4,8,6">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <StackPanel Orientation="Horizontal" Margin="6,4" Background="Transparent" Tag="{Binding}" MouseRightButtonUp="User_RightClick">
                                <Border Width="38" Height="38" CornerRadius="19" Background="{Binding AvatarBrush}" BorderBrush="{Binding RingBrush}" BorderThickness="2.5">
                                  <TextBlock Text="{Binding AvatarText}" FontFamily="{Binding AvatarFont}" FontSize="{Binding AvatarFontSize}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="White"/>
                                </Border>
                                <TextBlock Text="{Binding Nick}" Foreground="{Binding NickBrush}" VerticalAlignment="Center" Margin="12,0,0,0" FontSize="15"/>
                                <Border Visibility="{Binding BadgeVis}" Background="{Binding BadgeBg}" CornerRadius="4" Padding="5,1" Margin="10,0,0,0" VerticalAlignment="Center">
                                  <TextBlock Text="{Binding BadgeText}" FontSize="10" FontWeight="SemiBold" Foreground="{Binding BadgeFg}"/>
                                </Border>
                                <Button Visibility="{Binding VolumeVis}" Tag="{Binding}" Click="UserVolume_Click" Margin="10,0,0,0" Padding="8,4"
                                        Background="Transparent" VerticalAlignment="Center" ToolTip="{local:Tr vol_tip}">
                                  <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="{Binding VolumeGlyph}" FontSize="15" Foreground="{Binding VolumeBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding VolumeText}" FontSize="11" Foreground="{Binding VolumeBrush}" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                  </StackPanel>
                                </Button>
                                <Button Visibility="{Binding ManageVis}" Tag="{Binding}" Click="UserManage_Click" Margin="12,0,0,0" Padding="9,4"
                                        Background="#313A4D" VerticalAlignment="Center" ToolTip="{local:Tr user_manage}">
                                  <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE712;" FontSize="13" VerticalAlignment="Center"/>
                                    <TextBlock Text="{local:Tr user_manage_short}" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                  </StackPanel>
                                </Button>
                              </StackPanel>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>

          <!-- Wiadomości -->
          <Grid x:Name="PgChat" Visibility="Collapsed" Margin="18,14">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,10">
              <TextBlock Text="{local:Tr nav_chat}" FontSize="18" FontWeight="SemiBold"/>
              <TextBlock Text="{local:Tr chat_hint}" Foreground="{StaticResource Muted}" FontSize="12"/>
            </StackPanel>
            <Border Grid.Row="1" Background="{StaticResource Card}" CornerRadius="8" Padding="12">
              <ScrollViewer x:Name="ChatScroll" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="ChatList">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <TextBlock TextWrapping="Wrap" Margin="0,2">
                        <Run Text="{Binding Time, Mode=OneWay}" Foreground="{StaticResource Muted}"/>
                        <Run Text="{Binding Nick, Mode=OneWay}" Foreground="#6AA5FF" FontWeight="SemiBold"/>
                        <Run Text="{Binding Text, Mode=OneWay}"/>
                      </TextBlock>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Border>
            <DockPanel Grid.Row="2" Margin="0,10,0,0">
              <Button DockPanel.Dock="Right" Content="{local:Tr send}" Margin="8,0,0,0" Click="SendChat_Click"/>
              <TextBox x:Name="TxtChat" MaxLength="300" KeyDown="TxtChat_KeyDown"/>
            </DockPanel>
          </Grid>

          <!-- Użytkownicy -->
          <Grid x:Name="PgUsers" Visibility="Collapsed" Margin="18,14">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <TextBlock Text="{local:Tr users_title}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
            <ScrollViewer Grid.Row="1">
              <ItemsControl x:Name="AllUsersList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Background="{StaticResource Card}" CornerRadius="8" Padding="14,10" Margin="0,0,10,6">
                      <DockPanel>
                        <Button DockPanel.Dock="Right" Visibility="{Binding ManageVis}" Tag="{Binding}" Click="UserManage_Click" Margin="12,0,0,0" Padding="9,4"
                                Background="#313A4D" ToolTip="{local:Tr user_manage}">
                          <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE712;" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock Text="{local:Tr user_manage_short}" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center"/>
                          </StackPanel>
                        </Button>
                        <Button DockPanel.Dock="Right" Visibility="{Binding VolumeVis}" Tag="{Binding}" Click="UserVolume_Click" Margin="10,0,0,0" Padding="8,4"
                                Background="Transparent" ToolTip="{local:Tr vol_tip}">
                          <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="{Binding VolumeGlyph}" FontSize="15" Foreground="{Binding VolumeBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding VolumeText}" FontSize="11" Foreground="{Binding VolumeBrush}" Margin="5,0,0,0" VerticalAlignment="Center"/>
                          </StackPanel>
                        </Button>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding ChannelName}" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="{Binding Nick}" Foreground="{Binding NickBrush}" FontWeight="SemiBold"/>
                          <Border Visibility="{Binding BadgeVis}" Background="{Binding BadgeBg}" CornerRadius="4" Padding="5,1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding BadgeText}" FontSize="10" FontWeight="SemiBold" Foreground="{Binding BadgeFg}"/>
                          </Border>
                        </StackPanel>
                      </DockPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>

          <!-- Ustawienia -->
          <!-- Klienci (tylko Admin) -->
          <Grid x:Name="PgClients" Visibility="Collapsed" Margin="18,14">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,10">
              <TextBlock Text="{local:Tr cl_title}" FontSize="18" FontWeight="SemiBold"/>
              <TextBlock x:Name="TxtClientStats" FontSize="12" Foreground="{StaticResource Muted}"/>
            </StackPanel>
            <DockPanel Grid.Row="1" Margin="0,0,10,10">
              <ComboBox x:Name="CmbClientFilter" DockPanel.Dock="Right" Width="150" Margin="10,0,0,0" SelectionChanged="ClientFilter_Changed"/>
              <TextBox x:Name="TxtClientSearch" TextChanged="ClientSearch_Changed" ToolTip="{local:Tr cl_search}"/>
            </DockPanel>
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
              <ItemsControl x:Name="ClientsList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Background="{StaticResource Card}" CornerRadius="8" Padding="12,10" Margin="0,0,10,6" Opacity="{Binding RowOpacity}">
                      <DockPanel>
                        <Button DockPanel.Dock="Right" Visibility="{Binding ManageVis}" Tag="{Binding}" Click="ClientManage_Click"
                                Padding="12,6" Background="#313A4D" VerticalAlignment="Center">
                          <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE712;" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock Text="{local:Tr user_manage_short}" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center"/>
                          </StackPanel>
                        </Button>
                        <Ellipse DockPanel.Dock="Left" Width="10" Height="10" Fill="{Binding StatusBrush}" Margin="0,0,12,0"
                                 VerticalAlignment="Center" ToolTip="{Binding StatusText}"/>
                        <Border DockPanel.Dock="Left" Width="38" Height="38" CornerRadius="19" Background="{Binding AvatarBrush}" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Initial}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="White"/>
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                          <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Nick}" FontWeight="SemiBold" FontSize="15"/>
                            <Border Visibility="{Binding YouVis}" Background="#33FFFFFF" CornerRadius="4" Padding="5,1" Margin="10,0,0,0" VerticalAlignment="Center">
                              <TextBlock Text="{local:Tr cl_you}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Muted}"/>
                            </Border>
                            <Border Visibility="{Binding BadgeVis}" Background="{Binding BadgeBg}" CornerRadius="4" Padding="5,1" Margin="10,0,0,0" VerticalAlignment="Center">
                              <TextBlock Text="{Binding BadgeText}" FontSize="10" FontWeight="SemiBold" Foreground="{Binding BadgeFg}"/>
                            </Border>
                            <Border Visibility="{Binding BannedVis}" Background="#33D9363E" CornerRadius="4" Padding="5,1" Margin="10,0,0,0" VerticalAlignment="Center">
                              <TextBlock Text="{local:Tr cl_banned}" FontSize="10" FontWeight="SemiBold" Foreground="#FF7B7B"/>
                            </Border>
                          </StackPanel>
                          <TextBlock Text="{Binding SubText}" Foreground="{StaticResource Muted}" FontSize="12"/>
                        </StackPanel>
                      </DockPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>

          <ScrollViewer x:Name="PgSettings" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="18,14" MaxWidth="560" HorizontalAlignment="Left">
              <TextBlock Text="{local:Tr settings_title}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14"/>
              <TextBlock Text="{local:Tr language}" Margin="0,0,0,4"/>
              <ComboBox x:Name="CmbLang" SelectionChanged="Lang_Changed" Width="180" HorizontalAlignment="Left" Margin="0,0,0,12">
                <ComboBoxItem Content="Polski" Tag="pl"/>
                <ComboBoxItem Content="English" Tag="en"/>
              </ComboBox>
              <CheckBox x:Name="ChkAutoReconnect" Content="{local:Tr auto_reconnect}" Checked="AutoReconnect_Changed" Unchecked="AutoReconnect_Changed" Margin="0,0,0,14"/>
              <TextBlock Text="{local:Tr avatar}" Margin="0,0,0,2"/>
              <TextBlock Text="{local:Tr avatar_hint}" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,6"/>
              <WrapPanel x:Name="AvatarPanel" Margin="0,0,0,16"/>
              <TextBlock Text="{local:Tr mic}" Margin="0,0,0,4"/>
              <ComboBox x:Name="CmbMic" SelectionChanged="Mic_Changed" Margin="0,0,0,12"/>
              <TextBlock Text="{local:Tr speakers}" Margin="0,0,0,4"/>
              <ComboBox x:Name="CmbSpk" SelectionChanged="Spk_Changed" Margin="0,0,0,12"/>
              <TextBlock Text="{local:Tr tx_mode}" Margin="0,0,0,4"/>
              <RadioButton x:Name="RbVad" Content="{local:Tr mode_vad}" Checked="Mode_Changed" Margin="0,2"/>
              <RadioButton x:Name="RbPtt" Content="{local:Tr mode_ptt}" Checked="Mode_Changed" Margin="0,2,0,8"/>
              <Button x:Name="BtnPttKey" Content="Klawisz: V" HorizontalAlignment="Left" Background="{StaticResource CardHead}" Click="PttKey_Click" Margin="0,0,0,2"/>
              <TextBlock Text="{local:Tr ptt_hint}" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,0,0,14"/>
              <TextBlock Text="{local:Tr sensitivity}" Margin="0,0,0,6"/>
              <ProgressBar x:Name="MicBar" Minimum="0" Maximum="1" Height="8" Foreground="{StaticResource Green}" Background="{StaticResource Card}" BorderThickness="0"/>
              <Slider x:Name="SldThreshold" Minimum="0" Maximum="1" ValueChanged="Threshold_Changed" Margin="0,4,0,10"/>
              <Button x:Name="BtnLoop" Content="{local:Tr loop_start}" HorizontalAlignment="Left" Click="Loop_Click" Margin="0,0,0,4"/>
              <TextBlock Text="{local:Tr loop_hint}" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,14"/>

              <TextBlock Text="{local:Tr upd_title}" FontWeight="SemiBold" Margin="0,0,0,4"/>
              <TextBlock x:Name="TxtVersion" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,0,0,6"/>
              <CheckBox x:Name="ChkAutoUpdate" Content="{local:Tr upd_auto}" Checked="AutoUpdate_Changed" Unchecked="AutoUpdate_Changed" Margin="0,0,0,18"/>

              <StackPanel x:Name="PnlAdminLogin">
                <TextBlock Text="{local:Tr admin_title}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBlock Text="{local:Tr admin_desc}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,6"/>
                <DockPanel>
                  <Button DockPanel.Dock="Right" Content="{local:Tr login}" Margin="8,0,0,0" Click="AdminLogin_Click"/>
                  <PasswordBox x:Name="PwdAdmin"/>
                </DockPanel>
              </StackPanel>
              <TextBlock x:Name="TxtAdminStatus" Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap"/>

              <StackPanel x:Name="PnlAdmin" Visibility="Collapsed" Margin="0,10,0,0">
                <TextBlock Text="{local:Tr admin_panel}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <CheckBox x:Name="ChkSrvPwd" Content="{local:Tr chk_srvpwd}" Margin="0,0,0,6"/>
                <TextBlock Text="{local:Tr srvpwd_hint}" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                <DockPanel>
                  <Button DockPanel.Dock="Right" Content="{local:Tr save}" Margin="8,0,0,0" Click="SaveSrvPwd_Click"/>
                  <TextBox x:Name="TxtSrvPwd" MaxLength="64"/>
                </DockPanel>
                <TextBlock Text="{local:Tr admin_tips}" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"/>
              </StackPanel>

              <Border Height="1" Background="{StaticResource Line}" Margin="0,22,0,10"/>
              <TextBlock Text="{local:Tr footer}" FontSize="12" Foreground="{StaticResource Muted}"/>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Grid>

      <!-- dolny pasek -->
      <Border Grid.Row="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
        <Grid Margin="16,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Border x:Name="MeAvatar" Width="50" Height="50" CornerRadius="25" Background="{StaticResource Accent}">
              <TextBlock x:Name="MeInitial" Text="?" FontSize="20" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel VerticalAlignment="Center" Margin="14,0,24,0">
              <TextBlock x:Name="TxtMe" Text="Ty" FontSize="18" FontWeight="SemiBold"/>
              <TextBlock x:Name="TxtMeRank" Text="" FontSize="11" Foreground="{StaticResource Muted}"/>
            </StackPanel>
          </StackPanel>
          <Border Grid.Column="1" Background="{StaticResource Card}" CornerRadius="8" Padding="16,6" Margin="0,0,10,0" VerticalAlignment="Center">
            <StackPanel>
              <TextBlock Text="{local:Tr latency}" Foreground="{StaticResource Muted}" FontSize="12" HorizontalAlignment="Center"/>
              <TextBlock x:Name="TxtPing" Text="-- ms" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center"/>
            </StackPanel>
          </Border>
          <Border Grid.Column="2" Background="{StaticResource Card}" CornerRadius="8" Padding="16,6" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <StackPanel>
                <TextBlock Text="{local:Tr encryption}" Foreground="{StaticResource Muted}" FontSize="12"/>
                <TextBlock Text="AES-256" FontSize="17" FontWeight="SemiBold"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="14,0,0,2">
                <Rectangle x:Name="Bar1" Width="4" Height="7" Margin="1,0"/>
                <Rectangle x:Name="Bar2" Width="4" Height="12" Margin="1,0"/>
                <Rectangle x:Name="Bar3" Width="4" Height="17" Margin="1,0"/>
                <Rectangle x:Name="Bar4" Width="4" Height="22" Margin="1,0"/>
              </StackPanel>
            </StackPanel>
          </Border>
          <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
            <StackPanel Margin="4,0,18,0" Width="150">
              <StackPanel Orientation="Horizontal" Height="46">
                <TextBlock x:Name="IcoVol" FontFamily="Segoe MDL2 Assets" Text="&#xE767;" FontSize="18" Foreground="{StaticResource Muted}"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                <Slider x:Name="SldVolume" Minimum="0" Maximum="1" Width="108" VerticalAlignment="Center" IsMoveToPointEnabled="True"
                        SmallChange="0.05" LargeChange="0.1" ValueChanged="Volume_Changed" MouseWheel="Volume_Wheel"/>
              </StackPanel>
              <TextBlock x:Name="LblVol" FontSize="10" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
            </StackPanel>
            <StackPanel Margin="4,0">
              <Button x:Name="BtnMic" Width="52" Height="46" Padding="0" Click="Mic_Click">
                <Grid><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE720;" FontSize="20" HorizontalAlignment="Center"/>
                  <Rectangle x:Name="MicSlash" Width="28" Height="2.5" Fill="White" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5"><Rectangle.RenderTransform><RotateTransform Angle="-45"/></Rectangle.RenderTransform></Rectangle></Grid>
              </Button>
              <TextBlock x:Name="LblMic" Text="{local:Tr mute_mic}" FontSize="10" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
            </StackPanel>
            <StackPanel Margin="4,0">
              <Button x:Name="BtnDeaf" Width="52" Height="46" Padding="0" Click="Deaf_Click">
                <Grid><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE95B;" FontSize="20" HorizontalAlignment="Center"/>
                  <Rectangle x:Name="DeafSlash" Width="28" Height="2.5" Fill="White" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5"><Rectangle.RenderTransform><RotateTransform Angle="-45"/></Rectangle.RenderTransform></Rectangle></Grid>
              </Button>
              <TextBlock x:Name="LblDeaf" Text="{local:Tr mute_sound}" FontSize="10" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
            </StackPanel>
            <StackPanel Margin="4,0">
              <Button Width="52" Height="46" Padding="0" Background="{StaticResource Red}" Click="Leave_Click">
                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7E8;" FontSize="20" HorizontalAlignment="Center"/>
              </Button>
              <TextBlock Text="{local:Tr disconnect}" FontSize="10" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
            </StackPanel>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

    <!-- ===== EKRAN ŁĄCZENIA ===== -->
    <Grid x:Name="ConnectOverlay" Background="{StaticResource Bg}">
      <Border Width="390" VerticalAlignment="Center" HorizontalAlignment="Center" Background="{StaticResource Panel}" CornerRadius="12" Padding="28">
        <StackPanel>
          <ComboBox x:Name="CmbLangConn" SelectionChanged="Lang_Changed" Width="120" HorizontalAlignment="Right" Margin="0,0,0,6">
            <ComboBoxItem Content="Polski" Tag="pl"/>
            <ComboBoxItem Content="English" Tag="en"/>
          </ComboBox>
          <StackPanel Orientation="Horizontal">
            <Image Source="Assets/voxly.png" Width="60" Height="60" Margin="0,0,12,0" RenderOptions.BitmapScalingMode="HighQuality"/>
            <TextBlock Text="VOXLY" FontSize="32" FontWeight="Bold" Foreground="{StaticResource Accent}" VerticalAlignment="Center"/>
          </StackPanel>
          <TextBlock Text="{local:Tr tagline}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,20"/>
          <TextBlock Text="{local:Tr host_label}" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,0,0,3"/>
          <TextBox x:Name="TxtHost" Margin="0,0,0,10"/>
          <TextBlock Text="{local:Tr nick_label}" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,0,0,3"/>
          <TextBox x:Name="TxtNick" MaxLength="24" Margin="0,0,0,10"/>
          <TextBlock Text="{local:Tr pwd_label}" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,0,0,3"/>
          <PasswordBox x:Name="PwdKey" Margin="0,0,0,10"/>
          <CheckBox x:Name="ChkRemember" Content="{local:Tr remember}" IsChecked="True" Margin="0,0,0,14"/>
          <Button x:Name="BtnConnect" Content="{local:Tr connect}" IsDefault="True" Click="Connect_Click"/>
          <TextBlock x:Name="TxtConnStatus" Foreground="#FF7B7B" TextWrapping="Wrap" Margin="0,10,0,0" FontSize="12"/>
        </StackPanel>
      </Border>
    </Grid>

    <!-- ===== BANER AKTUALIZACJI ===== -->
    <Border x:Name="UpdateBanner" Visibility="Collapsed" VerticalAlignment="Top" Background="#1F3A5F" BorderBrush="{StaticResource Accent}"
            BorderThickness="0,0,0,1" Padding="14,8" Panel.ZIndex="100">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock x:Name="TxtUpdateBanner" FontWeight="SemiBold" TextWrapping="Wrap"/>
          <ProgressBar x:Name="PbUpdate" Height="6" Margin="0,6,0,0" Minimum="0" Maximum="1" Visibility="Collapsed"
                       Foreground="{StaticResource Green}" Background="{StaticResource Card}" BorderThickness="0"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="BtnUpdateNow" Content="{local:Tr upd_now}" Click="UpdateNow_Click" Margin="12,0,0,0"/>
          <Button x:Name="BtnUpdateLater" Content="{local:Tr upd_later}" Click="UpdateLater_Click" Background="#313A4D" Margin="8,0,0,0"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ===== PONOWNE ŁĄCZENIE ===== -->
    <Grid x:Name="ReconnectOverlay" Background="#CC141922" Visibility="Collapsed">
      <Border Width="390" VerticalAlignment="Center" HorizontalAlignment="Center" Background="{StaticResource Panel}" CornerRadius="12" Padding="28">
        <StackPanel>
          <TextBlock Text="{local:Tr reconnect_title}" FontSize="20" FontWeight="Bold" Margin="0,0,0,8"/>
          <TextBlock x:Name="TxtReconnectReason" Foreground="#FF7B7B" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,10"/>
          <TextBlock x:Name="TxtReconnectState" TextWrapping="Wrap" Margin="0,0,0,16"/>
          <Button Content="{local:Tr cancel}" Background="{StaticResource CardHead}" Click="CancelReconnect_Click"/>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
